# Maandelijkse welstand-/bereik-overlay (assistent)
# Onbewaakte missie-/onderhoudsronde (C1). Plaats als
# /etc/systemd/system/agent-doelgroep.service; geactiveerd door agent-doelgroep.timer.
# OWNER-ACTION: pas User/Group/WorkingDirectory/venv-pad aan (zie propaganda.service).
[Unit]
Description=Maandelijkse welstand-/bereik-overlay (assistent)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=propaganda
Group=propaganda
WorkingDirectory=/opt/propaganda-model
Environment=PROPAGANDA_DATA_DIR=/opt/propaganda-model/data
EnvironmentFile=-/etc/propaganda.env
# Harde stuck-detectie: een ronde die langer draait dan dit wordt gedood (SIGKILL);
# de timer rapporteert de mislukte unit (C4-toezicht).
TimeoutStartSec=1800
ExecStart=/opt/propaganda-model/.venv/bin/python3 scripts/agent_runner.py --agent assistent --label doelgroep --brief missies/doelgroep_brief.md --timeout 1800
# Bescheiden hardening; data/ blijft schrijfbaar voor het logbestand + run-record.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
