# Timer voor agent-scout.service — Kwartaal-structuurronde: nieuwe knopen & verbanden
# OWNER-ACTION: sudo systemctl enable --now agent-scout.timer
[Unit]
Description=Timer: Kwartaal-structuurronde: nieuwe knopen & verbanden

[Timer]
OnCalendar=*-01,04,07,10-01 04:00
# Loop een gemiste ronde na herstart/downtime alsnog in.
Persistent=true
# Spreid de last zodat niet elke agent op de seconde tegelijk start.
RandomizedDelaySec=600
Unit=agent-scout.service

[Install]
WantedBy=timers.target
