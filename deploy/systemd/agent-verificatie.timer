# Timer voor agent-verificatie.service — Dagelijkse onafhankelijke bron-herverificatie (immuunsysteem A1)
# OWNER-ACTION: sudo systemctl enable --now agent-verificatie.timer
[Unit]
Description=Timer: Dagelijkse onafhankelijke bron-herverificatie (immuunsysteem A1)

[Timer]
OnCalendar=*-*-* 02:00
# Loop een gemiste ronde na herstart/downtime alsnog in.
Persistent=true
# Spreid de last zodat niet elke agent op de seconde tegelijk start.
RandomizedDelaySec=600
Unit=agent-verificatie.service

[Install]
WantedBy=timers.target
