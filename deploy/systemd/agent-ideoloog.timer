# Timer voor agent-ideoloog.service — Maandelijkse politieke-kleurmeter-overlay (assistent)
# OWNER-ACTION: sudo systemctl enable --now agent-ideoloog.timer
[Unit]
Description=Timer: Maandelijkse politieke-kleurmeter-overlay (assistent)

[Timer]
OnCalendar=*-*-05 05:00
# Loop een gemiste ronde na herstart/downtime alsnog in.
Persistent=true
# Spreid de last zodat niet elke agent op de seconde tegelijk start.
RandomizedDelaySec=600
Unit=agent-ideoloog.service

[Install]
WantedBy=timers.target
