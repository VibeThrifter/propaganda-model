# Timer voor agent-archiveer.service — Wayback-archivering van url-bronnen zonder archive_url (C3)
# OWNER-ACTION: sudo systemctl enable --now agent-archiveer.timer
[Unit]
Description=Timer: Wayback-archivering van url-bronnen zonder archive_url (C3)

[Timer]
OnCalendar=*-*-* 01:00
# Loop een gemiste ronde na herstart/downtime alsnog in.
Persistent=true
# Spreid de last zodat niet elke agent op de seconde tegelijk start.
RandomizedDelaySec=600
Unit=agent-archiveer.service

[Install]
WantedBy=timers.target
