# Timer voor agent-resolutie.service — Maandelijkse voorspelling-deadline-resolutievoorstellen (A4)
# OWNER-ACTION: sudo systemctl enable --now agent-resolutie.timer
[Unit]
Description=Timer: Maandelijkse voorspelling-deadline-resolutievoorstellen (A4)

[Timer]
OnCalendar=*-*-02 05:30
# Loop een gemiste ronde na herstart/downtime alsnog in.
Persistent=true
# Spreid de last zodat niet elke agent op de seconde tegelijk start.
RandomizedDelaySec=600
Unit=agent-resolutie.service

[Install]
WantedBy=timers.target
